<configuration>
    <property resource="logback-variables.properties" />

    <!--
      파일 이름은 롤링 정책의 fileNamePattern 하나로만 정한다(<file>을 두지 않는다).
      전에는 <file>에 날짜 변수를 넣었는데, 에러 쪽은 정의되지 않은 ${TODAY}를 써서 그날 에러가
      'TODAY_IS_UNDEFINED_server.log'에 쌓였고, 정보 쪽 ${ToDay}는 서버를 띄운 날로 굳어 자정이 지나도
      그 이름에 계속 쓰였다. 배포로 프로세스가 바뀔 때마다 그 파일이 이름 규칙 밖에 남아 maxHistory로도
      지워지지 않았다. <file>이 없으면 지금 쓰는 파일이 곧 '20261016_server_0.log' 같은 오늘 날짜 파일이다.
    -->

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <Pattern>
                ${LOG_PATTERN}
            </Pattern>
        </layout>
    </appender>

    <appender name="FILE1" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>info</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_PATH}/info/%d{yyyyMMdd}_${LOG_FILE_NAME}_%i.log
            </fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE2" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>error</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_PATH}/error/%d{yyyyMMdd}_${LOG_FILE_NAME}_%i.log
            </fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="FILE1" />
        <appender-ref ref="FILE2" />
        <appender-ref ref="CONSOLE" />
    </root>

    <!-- RabbitMQ 관련 로거 설정 -->
    <logger name="org.springframework.amqp" level="DEBUG" />
    <logger name="org.springframework.amqp.rabbit.listener" level="DEBUG" />
    <logger name="org.springframework.amqp.rabbit.connection" level="DEBUG" />
    <logger name="com.silverithm.vehicleplacementsystem.config.RabbitMQConfig" level="DEBUG" />

    <!--
      소켓 CONNECT 거절(만료/위조/누락 토큰) 한 번마다 Spring이 이 로거에 DEBUG로
      "Failed to send message to MessageChannel in session ..."를 스택 91줄과 함께 남긴다
      (StompSubProtocolHandler.handleMessageFromClient의 catch(Throwable) 중 isDebugEnabled
      분기 — StompAuthChannelInterceptor가 던진 MessageDeliveryException을 그대로 감싼다).
      거절 사유는 이미 인터셉터가 한 줄 WARN으로 남기므로 그 뒤에 붙는 프레임워크 스택은
      전부 중복 소음이다(2026-09-14 배포에서 거절 2,156회로 로그 1,060줄).
      이 로거를 명시적으로 INFO로 못박아 상위(org.springframework.web=INFO) 설정이 어떤
      이유로든 흔들려도(운영에서 디버그 플래그가 남는 등) 이 스택은 다시 새지 않게 한다.
      이 메서드는 이 DEBUG 분기 밖에서는 애초에 스택을 남기지 않으므로(다른 커맨드 처리 중
      진짜 버그는 error(message)만, throwable 없이 찍는다) 이 지정으로 잃는 정보는 없다.
    -->
    <logger name="org.springframework.web.socket.messaging.StompSubProtocolHandler" level="INFO" />
</configuration>